msgstr "モデルごとに保存します。{text}: 原文（必須）、{source_lang}/{target_lang}: 英語の言語名、{source_code}/{target_code}: 言語コード。追加指示は基本指示の前に付けます。指示への対応はモデルにより異なります。"

msgctxt "SettingsDialog|"
msgid "The basic instructions for %1 must include {text} for the source text."
msgstr "%1 の基本指示には、原文を挿入する {text} が必要です。"

msgctxt "SettingsDialog|"
msgid "Optional style and terminology preferences, e.g. use polite Japanese."
msgstr "口調や用語の指定（任意）。例: 丁寧な日本語で翻訳する。"

msgctxt "SettingsDialog|"
msgid "Browse..."
msgstr "参照..."

msgctxt "CodexTranslationProvider|"
msgid "Codex request timed out. Increase the timeout in Translation settings or translate less text."
msgstr "Codex の処理がタイムアウトしました。翻訳設定のタイムアウトを延ばすか、翻訳する文章を短くしてください。"

msgctxt "CodexTranslationProvider|"
msgid "There is no text to translate or detect."
msgstr "翻訳または言語判定するテキストがありません。"

msgctxt "CodexTranslationProvider|"
msgid "Codex executable was not found. Install Codex CLI or select its executable in Translation settings."
msgstr "Codex 実行ファイルが見つかりません。Codex CLI をインストールするか、翻訳設定で実行ファイルを選択してください。"

msgctxt "CodexTranslationProvider|"
msgid "Could not create a temporary directory for Codex."
msgstr "Codex 用の一時ディレクトリを作成できませんでした。"

msgctxt "CodexTranslationProvider|"
msgid "Could not write the Codex response schema."
msgstr "Codex の応答スキーマを書き込めませんでした。"

msgctxt "CodexTranslationProvider|"
msgid "Could not create the Codex process group."
msgstr "Codex のプロセスグループを作成できませんでした。"

msgctxt "CodexTranslationProvider|"
msgid "Could not start Codex: %1"
msgstr "Codex を起動できませんでした: %1"

msgctxt "CodexTranslationProvider|"
msgid "Codex failed. Check CLI login (codex login), model access and usage limits.\n%1"
msgstr "Codex の処理に失敗しました。CLI のログイン（codex login）、モデルの利用権限、使用制限を確認してください。\n%1"

msgctxt "CodexTranslationProvider|"
msgid "Codex did not return a valid translation response."
msgstr "Codex から有効な翻訳結果を取得できませんでした。"

msgctxt "Cli|"
msgid "Specify translation provider ('copy', 'mozhi', 'localai' or 'codex'). Provider from app settings will be used by default."
msgstr "翻訳プロバイダー（'copy'、'mozhi'、'localai'、'codex'）を指定します。既定ではアプリの設定を使用します。"

msgctxt "TranslationActivityWidget|"
msgid "Cancel"
msgstr "中止"

msgctxt "TranslationActivityWidget|"
msgid "Translation progress"
msgstr "翻訳の進行状況"

msgctxt "SettingsDialog|"
msgid "Local translation models"
msgstr "ローカル翻訳モデル"

