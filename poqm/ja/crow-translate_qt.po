msgctxt "Cli|"
msgid "translation options:"
msgstr "翻訳オプション:"

msgctxt "Cli|"
msgid "examples:"
msgstr "例文:"

msgctxt "Cli|"
msgid "Display all language codes."
msgstr "すべての言語コードを表示します。"

msgctxt "Cli|"
msgid "Specify the source language (by default, engine will try to determine the language on its own)."
msgstr "翻訳元の言語を指定します（既定では、エンジンが自動的に判定します）。"

msgctxt "Cli|"
msgid "Specify the translation language(s), split by '+' (by default, the system language is used)."
msgstr "翻訳先の言語を '+' 区切りで指定します（既定ではシステムの言語が使われます）。"

msgctxt "Cli|"
msgid "Specify the translator engine ('google', 'yandex', 'bing', 'deepl', 'libretranslate', 'mymemory' or 'reverso'), Google is used by default."
msgstr "翻訳エンジン（'google'、'yandex'、'bing'、'deepl'、'libretranslate'、'mymemory'、'reverso'）を指定します。既定では Google が使われます。"

msgctxt "Cli|"
msgid "Specify Mozhi instance URL. Instance URL from the app settings will be used by default."
msgstr "Mozhi インスタンスの URL を指定します。既定ではアプリの設定にあるインスタンスの URL が使われます。"

msgctxt "Cli|"
msgid "Specify translation provider ('copy', 'mozhi' or 'localai'). Provider from app settings will be used by default."
msgstr "翻訳プロバイダー（'copy'、'mozhi'、'localai'）を指定します。既定ではアプリの設定にあるプロバイダーが使われます。"

msgctxt "Cli|"
msgid "Specify TTS provider ('none', 'mozhi', 'qt' or 'piper'). Provider from app settings will be used by default."
msgstr "TTS プロバイダー（'none'、'mozhi'、'qt'、'piper'）を指定します。既定ではアプリの設定にあるプロバイダーが使われます。"

msgctxt "Cli|"
msgid "Specify TTS provider ('none', 'mozhi' or 'qt'). Provider from app settings will be used by default."
msgstr "TTS プロバイダー（'none'、'mozhi'、'qt'）を指定します。既定ではアプリの設定にあるプロバイダーが使われます。"

msgctxt "Cli|"
msgid "Specify TTS provider ('none'). This build has text-to-speech disabled."
msgstr "TTS プロバイダー（'none'）を指定します。このビルドでは音声読み上げが無効になっています。"

msgctxt "Cli|"
msgid "Speak the translation."
msgstr "翻訳結果を読み上げます。"

msgctxt "Cli|"
msgid "Speak the source."
msgstr "原文を読み上げます。"

msgctxt "Cli|"
msgid "Read source text from files. Arguments will be interpreted as file paths."
msgstr "ファイルから原文を読み込みます。引数はファイルパスとして扱われます。"

msgctxt "Cli|"
msgid "Add stdin data to source text."
msgstr "標準入力のデータを原文に追加します。"

msgctxt "Cli|"
msgid "Read source text from an image using the configured OCR engine."
msgstr "設定済みの OCR エンジンを使って、画像から原文を読み取ります。"

msgctxt "Cli|"
msgid "path"
msgstr "パス"

msgctxt "Cli|"
msgid "Do not print any text when using --%1 or --%2."
msgstr "--%1 または --%2 の使用時は、テキストを出力しません。"

msgctxt "Cli|"
msgid "Print only translations."
msgstr "翻訳結果のみを出力します。"

msgctxt "Cli|"
msgid "Print output formatted as JSON."
msgstr "出力を JSON 形式で表示します。"

msgctxt "Cli|"
msgid "Which frontend to run ('gui' or 'cli'). Defaults to 'cli' whenever any argument is given."
msgstr "起動するフロントエンド（'gui' または 'cli'）を指定します。引数が指定された場合の既定は 'cli' です。"

